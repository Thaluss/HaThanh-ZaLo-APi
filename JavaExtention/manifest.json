{
	"name": "HaThanh Tools - IMEI & Cookies",
	"description": "Công cụ hỗ trợ chuyên nghiệp để lấy IMEI & Cookie của tài khoản Zalo.",
	"version": "1.0.2",
	"manifest_version": 3,
	"background": {
		"service_worker": "background.js"
	},
	"permissions": [
		"notifications",
		"activeTab",
		"cookies",
		"storage",
		"webRequest"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"icons": {
		"128": "./images/icon-128.png"
	},
	"action": {
		"default_icon": "./images/icon-128.png",
		"default_popup": "popup.html"
	}
}